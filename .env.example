# Copy to .env (git-ignored) and fill in. See USER_GUIDE.md, "Administrator setup".

# Google Classroom sign-in (leave blank to run the export in demo mode)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR-DOMAIN/api/v1/google-classroom/oauth/callback

# Optional
# SOR_SCOPE_FILE=examples/custom_scope.json
# SOR_CASE_LIVE=true
# SOR_CASE_CACHE_DIR=/data/case-cache
